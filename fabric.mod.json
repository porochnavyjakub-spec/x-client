package dev.xclient.util;

import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.player.LocalPlayer;
import net.minecraft.core.Direction;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.tags.BlockTags;
import net.minecraft.world.level.Level;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.RotatedPillarBlock;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraft.world.level.chunk.LevelChunk;
import net.minecraft.world.level.chunk.LevelChunkSection;

import java.util.*;

/**
 * Time-sliced scanner over the chunks the client has loaded. It looks for blocks that hint at player
 * activity (storage, hoppers, shulkers, rotated deepslate, ...) and scores every chunk.
 * Modules call {@link #want(int)} each tick; {@link #process} is run once per tick by the ModuleManager.
 */
public final class ChunkScanner {
    public static final ChunkScanner I = new ChunkScanner();

    public static final int K_CHEST = 1, K_BARREL = 2, K_ENDER = 3, K_SHULKER = 4, K_FURNACE = 5, K_HOPPER = 6,
            K_DISPENSER = 7, K_SPAWNER = 8, K_BED = 9, K_WORK = 10, K_ROTATED = 11, K_BUILD = 12, KINDS_N = 13;
    public static final String[] NAMES = {"", "chest", "barrel", "ender chest", "shulker", "furnace", "hopper",
            "dispenser", "spawner", "bed", "workstation", "rotated deepslate", "build blocks"};
    public static final int[] COLORS = {0, 0xFFFFA52E, 0xFFFFA52E, 0xFFB45CFF, 0xFFFF6FD8, 0xFF9AA0A6, 0xFF4DA6FF,
            0xFF4DA6FF, 0xFFFF3B3B, 0xFFE8E8EC, 0xFFB5A642, 0xFFFF5555, 0xFF55D6FF};
    // points per block and cap per kind (natural structures also contain some chests/beds, so those are cheap)
    private static final int[] WEIGHT = {0, 1, 2, 3, 4, 1, 3, 2, 0, 1, 1, 3, 1};
    private static final int[] CAP = {0, 20, 20, 15, 16, 8, 15, 10, 0, 5, 5, 30, 10};
    private static final int MAX_FOUND = 400;

    public record Found(int x, int y, int z, int kind) {}

    public static final class Info {
        public final int cx, cz;
        public final int[] counts = new int[KINDS_N];
        public final List<Found> found = new ArrayList<>();
        public int score;
        public double avgY = 64;
        long scannedAt = Long.MIN_VALUE;

        Info(int cx, int cz) { this.cx = cx; this.cz = cz; }
    }

    private static final Map<Block, Integer> KINDS = new IdentityHashMap<>();

    private static void put(int kind, Block... blocks) { for (Block b : blocks) KINDS.put(b, kind); }

    static {
        put(K_CHEST, Blocks.CHEST, Blocks.TRAPPED_CHEST);
        put(K_BARREL, Blocks.BARREL);
        put(K_ENDER, Blocks.ENDER_CHEST);
        put(K_FURNACE, Blocks.FURNACE, Blocks.BLAST_FURNACE, Blocks.SMOKER);
        put(K_HOPPER, Blocks.HOPPER);
        put(K_DISPENSER, Blocks.DISPENSER, Blocks.DROPPER);
        put(K_SPAWNER, Blocks.SPAWNER);
        put(K_WORK, Blocks.CRAFTING_TABLE, Blocks.ENCHANTING_TABLE, Blocks.ANVIL, Blocks.CHIPPED_ANVIL,
                Blocks.DAMAGED_ANVIL, Blocks.GRINDSTONE, Blocks.SMITHING_TABLE, Blocks.BREWING_STAND, Blocks.BEACON);
        for (Block b : BuiltInRegistries.BLOCK) {
            BlockState d = b.defaultBlockState();
            String p = BuiltInRegistries.BLOCK.getKey(b).getPath();
            if (d.is(BlockTags.SHULKER_BOXES)) KINDS.put(b, K_SHULKER);
            else if (d.is(BlockTags.BEDS)) KINDS.put(b, K_BED);
            else if (p.endsWith("concrete") || p.endsWith("_stained_glass") || p.equals("glass")
                    || p.equals("tinted_glass") || p.equals("sea_lantern")) KINDS.put(b, K_BUILD);
        }
    }

    public static int kind(BlockState s) {
        Block b = s.getBlock();
        Integer k = KINDS.get(b);
        if (k != null) return k;
        // natural deepslate is always axis=Y, so any other axis was placed by a player
        if (b == Blocks.DEEPSLATE && s.getValue(RotatedPillarBlock.AXIS) != Direction.Axis.Y) return K_ROTATED;
        return 0;
    }

    private static boolean interesting(BlockState s) { return kind(s) != 0; }

    public static long key(int cx, int cz) { return ((long) cx << 32) | (cz & 0xFFFFFFFFL); }

    public final Map<Long, Info> chunks = new HashMap<>();
    private ClientLevel lastLevel;
    private int want, idle;

    public void want(int radiusChunks) { want = Math.max(want, Math.min(16, radiusChunks)); }

    public void process(Minecraft mc) {
        ClientLevel w = mc.level;
        LocalPlayer p = mc.player;
        if (w == null || p == null) { chunks.clear(); lastLevel = null; return; }
        if (w != lastLevel) { chunks.clear(); lastLevel = w; }
        if (want == 0) { if (++idle > 200) chunks.clear(); return; }
        idle = 0;
        int r = want;
        want = 0;

        long now = w.getGameTime();
        int pcx = p.getBlockX() >> 4, pcz = p.getBlockZ() >> 4;
        int minY = w.dimension().equals(Level.OVERWORLD) ? -64 : 0;

        if (now % 20 == 0) {
            chunks.entrySet().removeIf(e -> Math.abs(e.getValue().cx - pcx) > r + 2
                    || Math.abs(e.getValue().cz - pcz) > r + 2
                    || w.getChunkSource().getChunkNow(e.getValue().cx, e.getValue().cz) == null);
        }

        List<int[]> todo = new ArrayList<>();
        for (int dx = -r; dx <= r; dx++)
            for (int dz = -r; dz <= r; dz++) {
                int cx = pcx + dx, cz = pcz + dz;
                Info i = chunks.get(key(cx, cz));
                boolean fresh = i == null;
                if ((fresh || now - i.scannedAt > 600) && w.getChunkSource().getChunkNow(cx, cz) != null)
                    todo.add(new int[]{cx, cz, fresh ? 0 : 1, dx * dx + dz * dz});
            }
        todo.sort(Comparator.<int[]>comparingInt(a -> a[2]).thenComparingInt(a -> a[3]));

        long end = System.nanoTime() + 3_000_000L;
        for (int[] t : todo) {
            if (System.nanoTime() > end) break;
            LevelChunk c = w.getChunkSource().getChunkNow(t[0], t[1]);
            if (c == null) continue;
            Info info = chunks.computeIfAbsent(key(t[0], t[1]), k -> new Info(t[0], t[1]));
            scan(c, info, minY);
            info.scannedAt = now;
        }
    }

    private void scan(LevelChunk c, Info info, int minY) {
        Arrays.fill(info.counts, 0);
        info.found.clear();
        long sumY = 0;
        int n = 0;
        LevelChunkSection[] secs = c.getSections();
        for (int si = 0; si < secs.length; si++) {
            LevelChunkSection s = secs[si];
            if (s == null || s.hasOnlyAir() || !s.maybeHas(ChunkScanner::interesting)) continue;
            int by = minY + si * 16;
            for (int y = 0; y < 16; y++)
                for (int z = 0; z < 16; z++)
                    for (int x = 0; x < 16; x++) {
                        int k = kind(s.getBlockState(x, y, z));
                        if (k == 0) continue;
                        info.counts[k]++;
                        sumY += by + y;
                        n++;
                        if (info.found.size() < MAX_FOUND)
                            info.found.add(new Found((info.cx << 4) + x, by + y, (info.cz << 4) + z, k));
                    }
        }
        int score = 0;
        for (int k = 1; k < KINDS_N; k++) score += Math.min(info.counts[k] * WEIGHT[k], CAP[k]);
        info.score = score;
        info.avgY = n > 0 ? sumY / (double) n : 64;
    }

    /** Short description of what makes a chunk suspicious, e.g. "hopper x4, ender chest x2". */
    public static String summary(Info i) {
        List<Integer> ks = new ArrayList<>();
        for (int k = 1; k < KINDS_N; k++) if (i.counts[k] > 0 && WEIGHT[k] > 0) ks.add(k);
        ks.sort((a, b) -> Integer.compare(i.counts[b] * WEIGHT[b], i.counts[a] * WEIGHT[a]));
        StringBuilder sb = new StringBuilder();
        for (int j = 0; j < Math.min(3, ks.size()); j++) {
            if (j > 0) sb.append(", ");
            sb.append(NAMES[ks.get(j)]).append(" x").append(i.counts[ks.get(j)]);
        }
        return sb.toString();
    }
}
